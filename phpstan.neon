includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 8
    treatPhpDocTypesAsCertain: false
    paths:
        - src
        - routes
    tmpDir: storage/phpstan
    bootstrapFiles:
        - stubs/slack-notification.stub
        - stubs/phpstan-bootstrap.php
    stubFiles:
        - stubs/slack-notification.stub
